{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "omniroute": {
      "name": "OmniRoute",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:20128/v1",
        "apiKey": "{env:OMNIROUTE_API_KEY}"
      },
      "models": {
        "combo/free-coding": {
          "limit": {
            "context": 200000,
            "output": 32768
          },
          "tool_call": true
        }
      }
    }
  },
  "model": "omniroute/combo/free-coding",
  "small_model": "omniroute/combo/free-coding"
}